# Copy to .env and fill in. Any credential the Anthropic SDK accepts works
# (ANTHROPIC_API_KEY, or an `ant auth login` profile with this left unset).
ANTHROPIC_API_KEY=

# Models: the agent being guarded, and the classifier guarding it.
# The classifier sits on the request path of every event; it is the main latency/cost lever.
AGENT_MODEL=claude-opus-5
GUARD_MODEL=claude-haiku-4-5
# Effort applies to Opus/Sonnet guard models; Haiku 4.5 has no effort parameter.
GUARD_EFFORT=low
# AGENT_EFFORT=high

# Active policy: policies/<POLICY>/
POLICY=ops-agent

# Server-side refusal fallbacks on Opus 5 (1 = on)
USE_FALLBACKS=1
