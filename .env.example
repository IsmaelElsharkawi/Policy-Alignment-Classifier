# Copy to .env and fill in. Any credential the Anthropic SDK accepts works
# (ANTHROPIC_API_KEY, or an `ant auth login` profile with this left unset).
ANTHROPIC_API_KEY=

# Models: the agent being guarded, and the classifier guarding it.
# The classifier sits on the request path of every event; it is the main latency/cost lever.
AGENT_MODEL=claude-opus-5
GUARD_MODEL=claude-haiku-4-5
# Effort applies to Opus/Sonnet guard models; Haiku 4.5 has no effort parameter.
GUARD_EFFORT=low
# AGENT_EFFORT=high

# Active policy: policies/<POLICY>/
POLICY=coding-agent

# Server-side refusal fallbacks on Opus 5 (1 = on)
USE_FALLBACKS=1

# Coding agent tools run real commands and edit real files. Either pin every session to one
# existing directory, or leave it unset for a fresh data/workspaces/<id>/ per session, cloned
# from AGENT_REPO if given. Commands get this machine's environment minus ANTHROPIC_* vars.
# AGENT_WORKSPACE=C:/path/to/a/checkout
# AGENT_REPO=https://github.com/huggingface/huggingface_hub.git
# COMMAND_TIMEOUT=120
# read_issue works unauthenticated on public repos (60 requests/hour); a token raises the limit.
# hub_info sends HF_TOKEN, if set, so it can see private and gated repos.
# GITHUB_TOKEN=
